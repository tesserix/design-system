{
  "name": "@tesserix/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Tesserix Design System - Shared UI components for web and React Native",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook",
    "docs:generate": "pnpm --filter @tesserix/docs generate:components",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "docs": "pnpm --filter @tesserix/docs dev",
    "dev:docs": "pnpm --filter @tesserix/docs dev",
    "build:docs": "pnpm --filter @tesserix/docs build",
    "start:docs": "pnpm --filter @tesserix/docs start"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.17.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/tesserix/design-system"
  },
  "keywords": [
    "design-system",
    "react",
    "react-native",
    "components",
    "ui",
    "tailwind"
  ],
  "author": "Tesserix",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "turbo": "^2.8.10"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "^7.29.6",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "@xmldom/xmldom": "^0.9.10",
      "dompurify": "^3.4.12",
      "esbuild": "^0.28.1",
      "flatted": "^3.4.2",
      "js-yaml@3": "^3.15.0",
      "js-yaml@4": "^4.2.0",
      "lodash-es": "^4.18.0",
      "mermaid": "^11.15.0",
      "minimatch@10": "^10.2.3",
      "next": "^16.2.6",
      "node-forge": "^1.4.0",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "postcss": "^8.5.10",
      "shell-quote": "^1.8.4",
      "turbo": "^2.9.14",
      "undici": "^7.28.0",
      "uuid": "^11.1.1",
      "vite": "^7.3.5",
      "vitest": "^4.1.0",
      "ws@6": "^6.2.4",
      "ws@7": "^7.5.11",
      "ws@8": "^8.21.0",
      "yaml": "^2.8.3"
    }
  }
}
