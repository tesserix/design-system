{
  "name": "@tesserix/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Tesserix Design System - Shared UI components for web and React Native",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook",
    "docs:generate": "pnpm --filter @tesserix/docs generate:components",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "docs": "pnpm --filter @tesserix/docs dev",
    "dev:docs": "pnpm --filter @tesserix/docs dev",
    "build:docs": "pnpm --filter @tesserix/docs build",
    "start:docs": "pnpm --filter @tesserix/docs start"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.18.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tesserix/design-system"
  },
  "keywords": [
    "design-system",
    "react",
    "react-native",
    "components",
    "ui",
    "tailwind"
  ],
  "author": "Tesserix",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "turbo": "^2.10.7"
  }
}
